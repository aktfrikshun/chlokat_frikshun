<main class="archive-shell">
  <section class="archive-hero">
    <p class="eyebrow">ChloKat Archive</p>
    <h1>Search the Chloe Katastrophe reconstruction.</h1>
    <p class="lede">
      Artifacts, songs, fragments, news, and public transmissions gathered in one place
      for the people following the signal.
    </p>

    <form class="archive-search" action="#" method="get">
      <label for="q">Search artifacts</label>
      <div>
        <input id="q" name="q" type="search" placeholder="Try songs, fragments, dates, lore, images">
        <button type="submit">Search</button>
      </div>
    </form>
  </section>

  <section class="archive-panels" aria-label="Archive entry points">
    <article>
      <h2>Latest Chloe News</h2>
      <p>Release notes, public updates, recovered transmissions, and new archive additions.</p>
    </article>

    <article>
      <h2>Recovered Artifacts</h2>
      <p>Images, lyrics, lore fragments, videos, and source notes marked safe for public discovery.</p>
    </article>

    <article>
      <h2>Music and Releases</h2>
      <p>Streaming links, release metadata, lyrics, related fragments, and campaign context.</p>
    </article>
  </section>
</main>
